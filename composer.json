{
    "name": "catlabinteractive/central-storage",
    "description": "Central file storage.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "airbrake/phpbrake": "^0.3.1",
        "aws/aws-php-sns-message-validator": "^1.4",
        "aws/aws-sdk-php": "^3.359.8",
        "barryvdh/laravel-ide-helper": "^2.15",
        "catlabinteractive/central-storage-client": "~1.0",
        "catlabinteractive/laravel-assets": "^3.0.8",
        "doctrine/dbal": "^3.5",
        "laravel/framework": "^10.0",
        "laravel/ui": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "madnest/madzipper": "^1.4",
        "watson/bootstrap-form": "^2.1",

        "ext-json": "*",
        "ext-intl": "*",
        "ext-bcmath" : "*",
        "ext-curl": "*",
        "ext-zip":  "*",
        "ext-imagick": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "~9.5"
    },
    "repositories": [
        {
            "type": "package",
            "package": {
                "name": "watson/bootstrap-form",
                "version": "2.4.0",
                "source": {
                    "type": "git",
                    "url": "https://github.com/dwightwatson/bootstrap-form.git",
                    "reference": "381d50796c63eff51ca6d27850018d6aeac3a065"
                },
                "dist": {
                    "type": "zip",
                    "url": "https://api.github.com/repos/dwightwatson/bootstrap-form/zipball/381d50796c63eff51ca6d27850018d6aeac3a065",
                    "reference": "381d50796c63eff51ca6d27850018d6aeac3a065"
                },
                "require": {
                    "php": "^8.0",
                    "illuminate/config": "~8.0|^9.0|^10.0",
                    "illuminate/session": "~8.0|^9.0|^10.0",
                    "illuminate/support": "~8.0|^9.0|^10.0",
                    "laravelcollective/html": "~6.0"
                },
                "autoload": {
                    "psr-4": {
                        "Watson\\BootstrapForm\\": "src/"
                    }
                },
                "extra": {
                    "laravel": {
                        "providers": [
                            "Watson\\BootstrapForm\\BootstrapFormServiceProvider"
                        ],
                        "aliases": {
                            "BootForm": "Watson\\BootstrapForm\\Facades\\BootstrapForm"
                        }
                    }
                }
            }
        }
    ],
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta",
            "php artisan optimize"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
          "php": "8.3"
        }
    }
}
