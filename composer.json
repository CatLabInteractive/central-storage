{
    "name": "catlabinteractive/central-storage",
    "description": "Central file storage.",
    "keywords": ["framework", "laravel"],
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.3",
        "airbrake/phpbrake": "^0.3.1",
        "aws/aws-php-sns-message-validator": "^1.4",
        "aws/aws-sdk-php": "^3.359.8",
        "barryvdh/laravel-ide-helper": "^3.0",
        "catlabinteractive/central-storage-client": "~1.0",
        "catlabinteractive/laravel-assets": "^4.0",
        "laravel/framework": "^12.0",
        "laravel/ui": "^4.0",
        "league/flysystem-aws-s3-v3": "^3.0",
        "madnest/madzipper": "^1.6",

        "ext-json": "*",
        "ext-intl": "*",
        "ext-bcmath" : "*",
        "ext-curl": "*",
        "ext-zip":  "*",
        "ext-imagick": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "classmap": [
            "database"
        ],
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-root-package-install": [
            "php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "php artisan key:generate"
        ],
        "post-install-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postInstall"
        ],
        "post-update-cmd": [
            "Illuminate\\Foundation\\ComposerScripts::postUpdate",
            "php artisan ide-helper:generate",
            "php artisan ide-helper:meta",
            "php artisan optimize"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover"
        ]
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "optimize-autoloader": true,
        "platform": {
          "php": "8.3"
        }
    }
}
